rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only approved accounts may access CRM data:
    //  - Madison, via Google sign-in (verified email)
    //  - the read-only Claude bot used by /api/crm (claude-crm-bot@paidcreative.com),
    //    matched by its fixed Firebase user ID and limited to reading
    function isMadison() {
      return request.auth != null
        && request.auth.token.email == 'madison@paidcreative.com'
        && request.auth.token.email_verified == true;
    }

    function isClaudeBot() {
      return request.auth != null
        && request.auth.uid == 'knRdea9M72PbV9wJX4ipnANUGbG2';
    }

    match /crm/{document} {
      allow read: if isMadison() || isClaudeBot();
      allow write: if isMadison();
    }
  }
}
